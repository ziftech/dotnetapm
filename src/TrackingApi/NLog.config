<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="false">
  <extensions>
    <add assembly="Elastic.CommonSchema.NLog" />
    <add assembly="Elastic.Apm.NLog" />
  </extensions>
  <targets>
    <target xsi:type="File"
            name="file"
            fileName="C:\lab\logs\tracking-api.log"
            layout="${longdate}|${level:uppercase=true}|${logger}|trace.id=${ElasticApmTraceId}|transaction.id=${ElasticApmTransactionId}|${message}${onexception:|${exception:format=tostring}}" />
    <target xsi:type="File"
            name="ecsFile"
            fileName="C:\lab\logs\tracking-api-ecs.json"
            layout="${EcsLayout}" />
  </targets>
  <rules>
    <logger name="*" minlevel="Info" writeTo="file,ecsFile" />
  </rules>
</nlog>
