<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="false">
  <!-- ContosoApm* renderers are intentionally not ThreadSafe/ThreadAgnostic so NLog
       evaluates them on the logging thread where profiler AsyncLocal transaction state lives.
       Keep Elastic.Apm.NLog loaded for package parity; Contoso renderers are what we use. -->
  <extensions>
    <add assembly="Elastic.CommonSchema.NLog" />
    <add assembly="Elastic.Apm.NLog" />
    <add assembly="Contoso.Observability" />
  </extensions>
  <targets>
    <target xsi:type="File"
            name="file"
            fileName="C:\lab\logs\tracking-api.log"
            concurrentWrites="false"
            keepFileOpen="true"
            layout="${longdate}|${level:uppercase=true}|${logger}|trace.id=${ContosoApmTraceId}|transaction.id=${ContosoApmTransactionId}|${message}${onexception:|${exception:format=tostring}}" />
    <target xsi:type="File"
            name="ecsFile"
            fileName="C:\lab\logs\tracking-api-ecs.json"
            concurrentWrites="false"
            keepFileOpen="true"
            layout="${EcsLayout}" />
  </targets>
  <rules>
    <logger name="*" minlevel="Info" writeTo="file,ecsFile" />
  </rules>
</nlog>
