<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/01/nuspec.xsd">
  <metadata>
    <id>Contoso.Observability.NLog</id>
    <version>1.0.0</version>
    <title>Contoso Observability NLog</title>
    <authors>Contoso Lab</authors>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <licenseUrl>https://opensource.org/licenses/MIT</licenseUrl>
    <description>NLog ${ContosoApmTraceId} / ${ContosoApmTransactionId} layout renderers.</description>
    <dependencies>
      <group targetFramework=".NETFramework4.6.2">
        <dependency id="Contoso.Observability" version="[1.0.0]" />
        <dependency id="NLog" version="4.7.0" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="..\..\src\Contoso.Observability.NLog\bin\Release\Contoso.Observability.NLog.dll" target="lib\net462\" />
  </files>
</package>
